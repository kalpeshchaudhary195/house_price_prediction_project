# ========================================================
# House Price Prediction - Environment Variables Template
# ========================================================

# Server Configuration
PORT=5000
HOST=0.0.0.0
DEBUG=false

# PostgreSQL Database Configuration
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
# Example: postgresql://postgres:postgres@localhost:5432/house_prediction
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/house_prediction

# Alternative Individual Database Environment Variables
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=house_prediction

# Frontend API URL (for Vite development)
VITE_API_BASE_URL=http://127.0.0.1:5000
